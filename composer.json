{
    "name": "shworx/spam-detector",
    "description": "A lightweight, configurable spam detection library for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0"
    },
    "autoload": {
        "psr-4": {
            "SHWorX\\SpamDetector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SHWorX\\SpamDetector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}